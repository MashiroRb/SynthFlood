\newlabel{tab:dose}{{2}{6}{Dose--response of agent decision quality under ambient contamination (Qwen2.5-7B backbone, mix contamination, $N{=}100$ tasks per dose; P4A). Confidence is the mean post-purchase verbalized confidence; ECE is expected calibration error over five equal-width bins.\relax }{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dose--response under ambient contamination: task success, regret, synthetic-purchase share, and mean confidence as functions of the contamination level $\varepsilon $ (mix families; $N{=}100$ tasks per dose; error bars = 95\% cluster-bootstrap CIs over tasks).\relax }}{6}{figure.caption.12}\protected@file@percent }
